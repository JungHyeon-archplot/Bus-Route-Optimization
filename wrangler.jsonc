{
  // npm run build 로 dist/를 만든 뒤 배포합니다. 비밀값은 여기 쓰지 말고 secret으로 넣으세요.
  "name": "bus-route-lab",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/config.json", "/live/*", "/records"]
  },
  // 팀 공유 실험 기록 (D1: 덮어쓰지 않고 쌓임, 넣는 즉시 모두에게 보임). 예전 KV 저장소는 옮기기용으로만 남김.
  "d1_databases": [{ "binding": "DB", "database_name": "bus-route-records", "database_id": "48b8a9b3-5a57-44de-9c22-4af78c28b791", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "RECORDS", "id": "96b3dfe86ab145aaa5452b145746e8e3" }]
}
